              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "if (corpo.id !== undefined && corpo.id !== null) { pm.environment.set('osId', corpo.id); }",
                  "if (corpo.sagaId !== undefined && corpo.sagaId !== null) { pm.environment.set('sagaId', corpo.sagaId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
