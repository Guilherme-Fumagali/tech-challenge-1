# Copie este arquivo para .env e ajuste os valores antes de rodar `docker compose up`.
# O .env real é gitignorado — nunca commitar segredos reais.

DB_USER=oficina
DB_PASS=oficina
JWT_SECRET=minha-chave-super-secreta-para-desenvolvimento-local-32chars
ADMIN_PASSWORD=admin123

# Notificação: "log" (apenas loga) ou "smtp" (envia via MailHog local)
NOTIFICACAO_CANAL=smtp
MAIL_FROM=oficina@example.com
